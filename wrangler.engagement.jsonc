{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "reliability-loop-engagement",

  "main": "worker/index.js",

  "compatibility_date": "2026-10-07",

  // Serve the API first-party on the site's domain. The site Worker owns
  // thereliabilityloop.com/*; this more specific route takes precedence.
  "routes": [
    {
      "pattern": "thereliabilityloop.com/api/*",
      "zone_name": "thereliabilityloop.com"
    }
  ],

  // Keep the workers.dev URL for local development and cached pages.
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "reliability_loop_db",
      "database_name": "reliability-loop-db",
      "database_id": "f9b3cf73-a9f6-4ba8-9458-4656249d1582"
    }
  ]
}
