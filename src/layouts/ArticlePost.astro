---
import type { CollectionEntry } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = CollectionEntry<'articles'>['data'];

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  tags,
  readTime,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<!doctype html>

<html lang="en">
  <head>
    <BaseHead
      title={`${title} | The Reliability Loop`}
      description={description}
    />

    <style is:global>
      .article-hero {
        position: relative;

        overflow: hidden;

        border-bottom: 1px solid var(--border);
      }

      .article-hero::before {
        content: "";

        position: absolute;

        width: 430px;
        height: 430px;

        top: -240px;
        right: -110px;

        border-radius: 50%;

        background: var(--lavender);

        opacity: 0.38;

        pointer-events: none;
      }

      .article-hero::after {
        content: "";

        position: absolute;

        width: 180px;
        height: 180px;

        top: -85px;
        right: 210px;

        border-radius: 50%;

        background: var(--wisteria);

        opacity: 0.2;

        pointer-events: none;
      }

      .article-header {
        position: relative;
        z-index: 1;

        width: min(900px, calc(100% - 48px));

        margin: 0 auto;

        padding: 82px 0 58px;
      }

      .article-category {
        display: inline-flex;
        align-items: center;

        gap: 9px;

        color: var(--purple);

        font-size: 12px;
        font-weight: 700;

        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .article-category::before {
        content: "";

        width: 26px;
        height: 3px;

        border-radius: 999px;

        background: var(--purple);
      }

      .article-title {
        max-width: 900px;

        margin: 20px 0 23px;

        color: var(--text);

        font-size: clamp(44px, 5.2vw, 66px);
        font-weight: 700;

        line-height: 1.04;
        letter-spacing: -0.047em;
      }

      .article-description {
        max-width: 760px;

        margin: 0;

        color: var(--text-muted);

        font-size: 19px;
        line-height: 1.58;
      }

      .article-metadata {
        display: flex;
        flex-wrap: wrap;
        align-items: center;

        gap: 10px 0;

        margin-top: 31px;

        color: var(--text-muted);

        font-size: 13px;
      }

      .article-metadata span {
        display: inline-flex;
        align-items: center;
      }

      .article-metadata span:not(:last-child)::after {
        content: "•";

        margin: 0 13px;

        color: var(--wisteria);
      }

      .article-metadata .author {
        color: var(--text);

        font-weight: 700;
      }

      .article-body {
        width: min(
          var(--content-width),
          calc(100% - 48px)
        );

        margin: 0 auto;

        padding: 58px 0 95px;

        color: var(--text-body);

        font-size: 18px;
        line-height: 1.7;
      }

      .article-body p {
        margin: 0 0 1.15em;

        color: var(--text-body);
      }

      .article-body h2 {
        position: relative;

        margin: 2.1em 0 0.7em;

        padding-bottom: 14px;

        color: var(--text);

        font-size: 33px;
        font-weight: 700;

        line-height: 1.18;
        letter-spacing: -0.035em;
      }

      .article-body h2::after {
        content: "";

        position: absolute;

        left: 0;
        bottom: 0;

        width: 52px;
        height: 4px;

        border-radius: 999px;

        background: var(--purple);
      }

      .article-body h3 {
        margin: 1.8em 0 0.65em;

        color: var(--text);

        font-size: 24px;
        font-weight: 700;

        line-height: 1.3;
        letter-spacing: -0.02em;
      }

      .article-body strong {
        color: var(--text);

        font-weight: 700;
      }

      .article-body em {
        color: #514858;
      }

      .article-body a {
        color: var(--purple);

        text-decoration-color: var(--wisteria);
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;

        transition: color 150ms ease;
      }

      .article-body a:hover {
        color: var(--purple-dark);
      }

      .article-body blockquote {
        position: relative;

        margin: 1.9em 0;

        padding: 24px 32px 24px 34px;

        border: 0;
        border-left: 5px solid var(--purple);
        border-radius: 0 12px 12px 0;

        background:
          linear-gradient(
            110deg,
            var(--lavender-soft),
            var(--wisteria-soft)
          );

        color: var(--text);

        font-size: 20px;
        font-weight: 700;

        line-height: 1.5;
      }

      .article-body blockquote::before {
        content: "“";

        position: absolute;

        top: 7px;
        right: 18px;

        color: var(--wisteria);

        font-family: Georgia, serif;
        font-size: 64px;

        line-height: 1;

        opacity: 0.7;
      }

      .article-body blockquote p {
        position: relative;
        z-index: 1;

        margin: 0;

        color: var(--text);
      }

      .article-body ul,
      .article-body ol {
        margin: 1.25em 0 1.45em;

        padding-left: 1.5em;
      }

      .article-body li {
        margin: 0.4em 0;

        padding-left: 0.25em;
      }

      .article-body li::marker {
        color: var(--purple);
      }

      .article-body code {
        padding: 0.15em 0.38em;

        border: 1px solid var(--border);
        border-radius: 5px;

        background: var(--wisteria-soft);

        color: var(--purple-dark);

        font-family:
          "SFMono-Regular",
          Consolas,
          "Liberation Mono",
          monospace;

        font-size: 0.86em;
      }

      .article-body pre {
        overflow-x: auto;

        margin: 1.8em 0;

        padding: 24px 27px;

        border: 1px solid #35283d;
        border-radius: 12px;

        background: #211a27;
        color: #f8f5fa;

        box-shadow:
          0 12px 30px
          rgba(50, 20, 60, 0.06);
      }

      .article-body pre code {
        padding: 0;

        border: 0;

        background: transparent;
        color: inherit;

        font-size: 14px;
        line-height: 1.65;
      }

      .article-body hr {
        margin: 3em 0;

        border: 0;
        border-top: 1px solid var(--border);
      }

      .article-body table {
        width: 100%;

        margin: 1.8em 0;

        border-collapse: collapse;

        font-size: 15px;
      }

      .article-body th,
      .article-body td {
        padding: 12px 14px;

        border: 1px solid var(--border);

        text-align: left;
        vertical-align: top;
      }

      .article-body th {
        background: var(--wisteria-soft);

        color: var(--text);

        font-weight: 700;
      }

      .article-body img {
        width: 100%;

        margin: 2em 0;

        border: 1px solid var(--border);
        border-radius: 12px;
      }

      .article-tags {
        width: min(
          var(--content-width),
          calc(100% - 48px)
        );

        margin: -55px auto 72px;

        display: flex;
        flex-wrap: wrap;

        gap: 9px;
      }

      .article-tag {
        padding: 7px 11px;

        border: 1px solid var(--wisteria);
        border-radius: 999px;

        background: var(--wisteria-soft);

        color: #5c435f;

        font-size: 11px;
        font-weight: 700;
      }

      .article-end {
        width: min(
          var(--content-width),
          calc(100% - 48px)
        );

        margin: 0 auto 68px;

        display: flex;
        align-items: center;

        gap: 12px;

        color: var(--text-muted);

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .article-end::before {
        content: "";

        width: 38px;
        height: 4px;

        border-radius: 999px;

        background: var(--purple);
      }

      .article-end::after {
        content: "";

        width: 9px;
        height: 9px;

        border-radius: 50%;

        background: var(--pink);
      }

      @media (max-width: 760px) {
        .article-header,
        .article-body,
        .article-tags,
        .article-end {
          width: min(
            100% - 32px,
            var(--wide-width)
          );
        }

        .article-header {
          padding: 58px 0 44px;
        }

        .article-title {
          margin-top: 17px;

          font-size:
            clamp(39px, 12vw, 52px);

          line-height: 1.04;
          letter-spacing: -0.043em;
        }

        .article-description {
          font-size: 17px;
          line-height: 1.55;
        }

        .article-metadata {
          margin-top: 27px;
        }

        .article-body {
          padding-top: 48px;

          font-size: 17px;
          line-height: 1.68;
        }

        .article-body p {
          margin-bottom: 1.1em;
        }

        .article-body h2 {
          margin-top: 1.9em;

          font-size: 29px;
        }

        .article-body h3 {
          font-size: 22px;
        }

        .article-body blockquote {
          margin: 1.7em 0;

          padding: 22px 23px;

          font-size: 18px;
        }

        .article-body table {
          display: block;

          overflow-x: auto;
        }

        .article-hero::before {
          opacity: 0.2;
        }

        .article-hero::after {
          display: none;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <article>
        <section class="article-hero">
          <div class="article-header">
            <div class="article-category">
              {category}
            </div>

            <h1 class="article-title">
              {title}
            </h1>

            <p class="article-description">
              {description}
            </p>

            <div class="article-metadata">
              <span class="author">
                {author}
              </span>

              <span>
                {formattedDate}
              </span>

              <span>
                {readTime}
              </span>

              {
                updatedDate && (
                  <span>
                    Updated {formattedUpdatedDate}
                  </span>
                )
              }
            </div>
          </div>
        </section>

        <div class="article-body">
          <slot />
        </div>

        {
          tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag) => (
                <span class="article-tag">
                  {tag}
                </span>
              ))}
            </div>
          )
        }

        <div class="article-end">
          End of article
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>