---
import type { CollectionEntry } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleEngagement from '../components/ArticleEngagement.astro';
import ArticleComments from '../components/ArticleComments.astro';

type Props =
  CollectionEntry<'articles'>['data'] & {
    slug: string;
  };

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  tags,
  readTime,
  slug,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

const categoryThemeMap: Record<string, string> = {
  'SRE': 'sre',
  'Platform Engineering': 'platform',
  'Distributed Systems': 'distributed',
  'Observability': 'observability',
  'AI & Automation': 'ai',
};

const theme = categoryThemeMap[category] ?? 'sre';
---

<!doctype html>

<html lang="en">
  <head>
    <BaseHead
      title={`${title} | The Reliability Loop`}
      description={description}
    />

    <style is:global>
      /*
       * CATEGORY THEMES
       *
       * SRE                  → Wisteria / Purple
       * Platform Engineering → Cyan / Blue
       * Distributed Systems  → Amber / Orange
       * Observability        → Emerald / Teal
       * AI & Automation      → Violet / Pink
       */

      .article-theme {
        --article-accent: #9400d3;
        --article-accent-dark: #7000a3;
        --article-accent-soft: #eeeeff;
        --article-accent-soft-2: #f2eaf2;
        --article-accent-border: #d8bfd8;
        --article-accent-muted: #b989c8;
        --article-orb-primary: #d3d3ff;
        --article-orb-secondary: #d8bfd8;
        --article-end-secondary: #ed80e9;
        --article-code-bg: #f2eaf2;
        --article-code-text: #7000a3;
      }

      .article-theme[data-theme="platform"] {
        --article-accent: #087fdb;
        --article-accent-dark: #075fa4;
        --article-accent-soft: #eaf6ff;
        --article-accent-soft-2: #edf9fc;
        --article-accent-border: #a9d9f5;
        --article-accent-muted: #75b9e6;
        --article-orb-primary: #b9ddff;
        --article-orb-secondary: #9de4ed;
        --article-end-secondary: #22b8cf;
        --article-code-bg: #edf7fd;
        --article-code-text: #075fa4;
      }

      .article-theme[data-theme="distributed"] {
        --article-accent: #d97706;
        --article-accent-dark: #a84f04;
        --article-accent-soft: #fff5df;
        --article-accent-soft-2: #fff8eb;
        --article-accent-border: #f1c77c;
        --article-accent-muted: #e0a64c;
        --article-orb-primary: #ffe1a6;
        --article-orb-secondary: #ffd0a1;
        --article-end-secondary: #f05a28;
        --article-code-bg: #fff5e6;
        --article-code-text: #9a4a05;
      }

      .article-theme[data-theme="observability"] {
        --article-accent: #07876f;
        --article-accent-dark: #056553;
        --article-accent-soft: #e7f8f3;
        --article-accent-soft-2: #edf9f5;
        --article-accent-border: #9bd9c8;
        --article-accent-muted: #62bca5;
        --article-orb-primary: #b6eadc;
        --article-orb-secondary: #a9e5d9;
        --article-end-secondary: #1ba6a6;
        --article-code-bg: #eaf8f4;
        --article-code-text: #056553;
      }

      .article-theme[data-theme="ai"] {
        --article-accent: #8b36d9;
        --article-accent-dark: #6923ad;
        --article-accent-soft: #f1eafe;
        --article-accent-soft-2: #fbeafa;
        --article-accent-border: #d7b9ed;
        --article-accent-muted: #bd8dd9;
        --article-orb-primary: #d8ccff;
        --article-orb-secondary: #f1c5ea;
        --article-end-secondary: #ed80e9;
        --article-code-bg: #f3edfd;
        --article-code-text: #6923ad;
      }

      .article-hero {
        position: relative;
        overflow: hidden;

        border-bottom: 1px solid var(--border);

        background:
          linear-gradient(
            135deg,
            var(--background) 0%,
            var(--article-accent-soft) 145%
          );
      }

      .article-hero::before {
        content: "";

        position: absolute;

        width: 430px;
        height: 430px;

        top: -240px;
        right: -110px;

        border-radius: 50%;

        background: var(--article-orb-primary);

        opacity: 0.42;

        pointer-events: none;
      }

      .article-hero::after {
        content: "";

        position: absolute;

        width: 180px;
        height: 180px;

        top: -85px;
        right: 210px;

        border-radius: 50%;

        background: var(--article-orb-secondary);

        opacity: 0.25;

        pointer-events: none;
      }

      .article-header {
        position: relative;
        z-index: 1;

        width: min(900px, calc(100% - 48px));

        margin: 0 auto;

        padding: 68px 0 48px;
      }

      .article-category {
        display: inline-flex;
        align-items: center;

        gap: 9px;

        color: var(--article-accent);

        font-size: 12px;
        font-weight: 700;

        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .article-category::before {
        content: "";

        width: 26px;
        height: 3px;

        border-radius: 999px;

        background: var(--article-accent);
      }

      .article-title {
        max-width: 900px;

        margin: 20px 0 23px;

        color: var(--text);

        font-size: clamp(44px, 5.2vw, 66px);
        font-weight: 700;

        line-height: 1.04;
        letter-spacing: -0.047em;
      }

      .article-description {
        max-width: 760px;

        margin: 0;

        color: var(--text-muted);

        font-size: 19px;
        line-height: 1.58;
      }

      .article-metadata {
        display: flex;
        flex-wrap: wrap;
        align-items: center;

        gap: 10px 0;

        margin-top: 31px;

        color: var(--text-muted);

        font-size: 13px;
      }

      .article-metadata span {
        display: inline-flex;
        align-items: center;
      }

      .article-metadata span:not(:last-child)::after {
        content: "•";

        margin: 0 13px;

        color: var(--article-accent-muted);
      }

      .article-metadata .author {
        color: var(--text);

        font-weight: 700;
      }

      .article-body {
        width: min(
          var(--content-width),
          calc(100% - 48px)
        );

        margin: 0 auto;

        padding: 48px 0 90px;

        color: var(--text-body);

        font-size: 18px;
        line-height: 1.64;
      }

      .article-body p {
        margin: 0 0 0.95em;

        color: var(--text-body);
      }

      .article-body h2 {
        position: relative;

        margin: 2.1em 0 0.7em;

        padding-bottom: 14px;

        color: var(--text);

        font-size: 33px;
        font-weight: 700;

        line-height: 1.18;
        letter-spacing: -0.035em;
      }

      .article-body h2::after {
        content: "";

        position: absolute;

        left: 0;
        bottom: 0;

        width: 52px;
        height: 4px;

        border-radius: 999px;

        background: var(--article-accent);
      }

      .article-body h3 {
        margin: 1.8em 0 0.65em;

        color: var(--text);

        font-size: 24px;
        font-weight: 700;

        line-height: 1.3;
        letter-spacing: -0.02em;
      }

      .article-body strong {
        color: var(--text);

        font-weight: 700;
      }

      .article-body em {
        color: #514858;
      }

      .article-body a {
        color: var(--article-accent);

        text-decoration-color: var(--article-accent-border);
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;

        transition: color 150ms ease;
      }

      .article-body a:hover {
        color: var(--article-accent-dark);
      }

      .article-body blockquote {
        position: relative;

        margin: 1.9em 0;

        padding: 24px 32px 24px 34px;

        border: 0;
        border-left: 5px solid var(--article-accent);
        border-radius: 0 12px 12px 0;

        background:
          linear-gradient(
            110deg,
            var(--article-accent-soft),
            var(--article-accent-soft-2)
          );

        color: var(--text);

        font-size: 20px;
        font-weight: 700;

        line-height: 1.5;
      }

      .article-body blockquote::before {
        content: "“";

        position: absolute;

        top: 7px;
        right: 18px;

        color: var(--article-accent-border);

        font-family: Georgia, serif;
        font-size: 64px;

        line-height: 1;

        opacity: 0.8;
      }

      .article-body blockquote p {
        position: relative;
        z-index: 1;

        margin: 0;

        color: var(--text);
      }

      .article-body ul,
      .article-body ol {
        margin: 1.25em 0 1.45em;

        padding-left: 1.5em;
      }

      .article-body li {
        margin: 0.4em 0;

        padding-left: 0.25em;
      }

      .article-body li::marker {
        color: var(--article-accent);
      }

      .article-body code {
        padding: 0.15em 0.38em;

        border: 1px solid var(--article-accent-border);
        border-radius: 5px;

        background: var(--article-code-bg);

        color: var(--article-code-text);

        font-family:
          "SFMono-Regular",
          Consolas,
          "Liberation Mono",
          monospace;

        font-size: 0.86em;
      }

      .article-body pre {
        overflow-x: auto;

        margin: 1.8em 0;

        padding: 24px 27px;

        border: 1px solid #35283d;
        border-radius: 12px;

        background: #211a27;
        color: #f8f5fa;

        box-shadow:
          0 12px 30px
          rgba(50, 20, 60, 0.06);
      }

      .article-body pre code {
        padding: 0;

        border: 0;

        background: transparent;
        color: inherit;

        font-size: 14px;
        line-height: 1.65;
      }

      .article-body hr {
        margin: 3em 0;

        border: 0;
        border-top: 1px solid var(--border);
      }

      .article-body table {
        width: 100%;

        margin: 1.8em 0;

        border-collapse: collapse;

        font-size: 15px;
      }

      .article-body th,
      .article-body td {
        padding: 12px 14px;

        border: 1px solid var(--border);

        text-align: left;
        vertical-align: top;
      }

      .article-body th {
        background: var(--article-accent-soft);

        color: var(--text);

        font-weight: 700;
      }

      .article-body img {
        width: 100%;

        margin: 2em 0;

        border: 1px solid var(--border);
        border-radius: 12px;
      }

      .article-tags {
        width: min(
          var(--content-width),
          calc(100% - 48px)
        );

        margin: -55px auto 72px;

        display: flex;
        flex-wrap: wrap;

        gap: 9px;
      }

      .article-tag {
        padding: 7px 11px;

        border: 1px solid var(--article-accent-border);
        border-radius: 999px;

        background: var(--article-accent-soft);

        color: var(--article-accent-dark);

        font-size: 11px;
        font-weight: 700;
      }

      .article-end {
        width: min(
          var(--content-width),
          calc(100% - 48px)
        );

        margin: 0 auto 68px;

        display: flex;
        align-items: center;

        gap: 12px;

        color: var(--text-muted);

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .article-end::before {
        content: "";

        width: 38px;
        height: 4px;

        border-radius: 999px;

        background: var(--article-accent);
      }

      .article-end::after {
        content: "";

        width: 9px;
        height: 9px;

        border-radius: 50%;

        background: var(--article-end-secondary);
      }

      @media (max-width: 760px) {
        .article-header,
        .article-body,
        .article-tags,
        .article-end {
          width: min(
            100% - 32px,
            var(--wide-width)
          );
        }

        .article-header {
          padding: 52px 0 40px;
        }

        .article-title {
          margin-top: 17px;

          font-size:
            clamp(39px, 12vw, 52px);

          line-height: 1.04;
          letter-spacing: -0.043em;
        }

        .article-description {
          font-size: 17px;
          line-height: 1.55;
        }

        .article-metadata {
          margin-top: 27px;
        }

        .article-body {
          padding-top: 42px;

          font-size: 17px;
          line-height: 1.64;
        }

        .article-body p {
          margin-bottom: 0.95em;
        }

        .article-body h2 {
          margin-top: 1.9em;

          font-size: 29px;
        }

        .article-body h3 {
          font-size: 22px;
        }

        .article-body blockquote {
          margin: 1.7em 0;

          padding: 22px 23px;

          font-size: 18px;
        }

        .article-body table {
          display: block;

          overflow-x: auto;
        }

        .article-hero::before {
          opacity: 0.22;
        }

        .article-hero::after {
          display: none;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <article
        class="article-theme"
        data-theme={theme}
      >
        <section class="article-hero">
          <div class="article-header">
            <div class="article-category">
              {category}
            </div>

            <h1 class="article-title">
              {title}
            </h1>

            <p class="article-description">
              {description}
            </p>

            <div class="article-metadata">
              <span class="author">
                {author}
              </span>

              <span>
                {formattedDate}
              </span>

              <span>
                {readTime}
              </span>

              {
                updatedDate && (
                  <span>
                    Updated {formattedUpdatedDate}
                  </span>
                )
              }
            </div>
            <ArticleEngagement slug={slug} />
          </div>
        </section>

        <div class="article-body">
          <slot />
        </div>

        {
          tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag) => (
                <span class="article-tag">
                  {tag}
                </span>
              ))}
            </div>
          )
        }

        <div class="article-end">
          End of article
        </div>

        <ArticleComments slug={slug} />

      </article>
    </main>
    <Footer />
  </body>
</html>