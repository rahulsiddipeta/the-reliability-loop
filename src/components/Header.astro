---
const pathname = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === '/') {
    return pathname === '/';
  }

  return pathname.startsWith(path);
};
---

<header class="site-header">
  <nav class="site-nav site-container">
    <a href="/" class="site-brand">
      THE RELIABILITY LOOP
    </a>

    <div class="site-links">
      <a
        href="/"
        class:list={{ active: isActive('/') }}
      >
        Home
      </a>

      <a
        href="/articles"
        class:list={{ active: isActive('/articles') }}
      >
        Articles
      </a>

      <a
        href="/topics"
        class:list={{ active: isActive('/topics') }}
      >
        Topics
      </a>

      <a
        href="/about"
        class:list={{ active: isActive('/about') }}
      >
        About
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;

    border-bottom: 1px solid var(--border);

    background: rgba(248, 247, 252, 0.96);
  }

  .site-nav {
    min-height: 76px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 32px;
  }

  .site-brand {
    color: var(--text);

    text-decoration: none;

    font-size: 13px;
    font-weight: 700;

    letter-spacing: 0.15em;
  }

  .site-links {
    display: flex;
    align-items: center;

    gap: 30px;
  }

  .site-links a {
    position: relative;

    padding: 28px 0 24px;

    color: var(--text-muted);

    text-decoration: none;

    font-size: 14px;
    font-weight: 400;

    transition: color 160ms ease;
  }

  .site-links a:hover {
    color: var(--purple);
  }

  .site-links a.active {
    color: var(--purple);
  }

  .site-links a.active::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: -1px;

    height: 3px;

    border-radius: 999px 999px 0 0;

    background: var(--purple);
  }

  @media (max-width: 650px) {
    .site-nav {
      min-height: 68px;
    }

    .site-links {
      gap: 16px;
    }

    .site-links a {
      padding: 24px 0 21px;

      font-size: 13px;
    }

    .site-links a:first-child {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .site-brand {
      font-size: 11px;

      letter-spacing: 0.1em;
    }

    .site-links {
      gap: 12px;
    }

    .site-links a {
      font-size: 12px;
    }
  }
</style>