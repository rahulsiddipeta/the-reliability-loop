---
import type { CollectionEntry } from 'astro:content';

import { topics } from '../topics';

interface Props {
  articles: CollectionEntry<'articles'>[];
  active?: string;
}

const { articles, active } = Astro.props;

const countFor = (name: string) =>
  articles.filter((article) => article.data.category === name).length;
---

<nav class="topic-filter" aria-label="Filter articles by topic">
  <a
    class:list={['pill', { active: !active }]}
    href="/articles"
    aria-current={!active ? 'page' : undefined}
  >
    All
  </a>

  {
    topics.map((topic) => (
      <a
        class:list={['pill', { active: active === topic.id }]}
        href={`/topics/${topic.id}`}
        aria-current={active === topic.id ? 'page' : undefined}
      >
        {topic.name}
        <span class="count">{countFor(topic.name)}</span>
      </a>
    ))
  }
</nav>

<style>
  .topic-filter {
    display: flex;
    flex-wrap: wrap;

    gap: 9px;

    margin-top: 32px;
  }

  .pill {
    display: inline-flex;
    align-items: center;

    gap: 8px;

    padding: 8px 13px;

    border: 1px solid var(--wisteria);
    border-radius: 999px;

    background: var(--wisteria-soft);

    color: #5c435f;

    font-size: 12px;

    text-decoration: none;

    transition:
      border-color 150ms ease,
      background 150ms ease,
      color 150ms ease;
  }

  .pill:hover {
    border-color: var(--purple);

    background: var(--lavender-soft);

    color: var(--purple-dark);
  }

  .pill.active {
    border-color: var(--purple);

    background: var(--purple);

    color: #ffffff;
  }

  .count {
    opacity: 0.7;

    font-size: 11px;
    font-weight: 700;
  }
</style>
