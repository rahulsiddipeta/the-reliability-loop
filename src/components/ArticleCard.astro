---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
---

<article class="article-card">
  <a
    class="article-link"
    href={`/articles/${article.id}`}
  >
    <div class="category">
      {article.data.category}
    </div>

    <h2>
      {article.data.title}
    </h2>

    <p class="description">
      {article.data.description}
    </p>

    <div class="meta">
      <span>
        {formatDate(article.data.pubDate)}
      </span>

      <span>
        {article.data.readTime}
      </span>

      <span class="read">
        Read →
      </span>
    </div>
  </a>
</article>

<style>
  .article-card {
    min-height: 300px;

    padding: 30px;

    display: flex;
    flex-direction: column;

    border: 1px solid var(--border);
    border-radius: 14px;

    background: rgba(255, 255, 255, 0.55);

    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .article-card:hover {
    transform: translateY(-3px);

    border-color: var(--wisteria);

    background: var(--surface);
  }

  .article-link {
    height: 100%;

    display: flex;
    flex-direction: column;

    text-decoration: none;
  }

  .category {
    color: var(--purple);

    font-size: 11px;
    font-weight: 700;

    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h2 {
    margin: 14px 0;

    color: var(--text);

    font-size: 30px;
    font-weight: 700;

    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .description {
    margin: 0;

    color: var(--text-muted);

    font-size: 16px;
    line-height: 1.6;
  }

  .meta {
    margin-top: auto;
    padding-top: 28px;

    display: flex;
    flex-wrap: wrap;

    gap: 7px 18px;

    color: var(--text-muted);

    font-size: 12px;
  }

  .read {
    color: var(--purple);

    font-weight: 700;
  }

  @media (max-width: 760px) {
    .article-card {
      min-height: 260px;
    }
  }
</style>
