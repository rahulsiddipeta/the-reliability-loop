---
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.pubDate.valueOf() -
    a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
---

<!doctype html>

<html lang="en">
  <head>
    <BaseHead
      title="Articles | The Reliability Loop"
      description="Field notes and deep dives on SRE, platform engineering, distributed systems, observability, AI and automation."
    />

    <style>
      .page-hero {
        position: relative;

        overflow: hidden;

        padding: 82px 0 66px;

        border-bottom: 1px solid var(--border);
      }

      .page-hero::before {
        content: "";

        position: absolute;

        width: 380px;
        height: 380px;

        top: -230px;
        right: -80px;

        border-radius: 50%;

        background: var(--lavender);

        opacity: 0.35;
      }

      .hero-inner {
        position: relative;
        z-index: 1;
      }

      .page-title {
        margin-top: 20px;
      }

      .articles-section {
        padding: 65px 0 95px;
      }

      .articles-grid {
        display: grid;

        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        gap: 26px;
      }

      .article-card {
        min-height: 300px;

        padding: 30px;

        display: flex;
        flex-direction: column;

        border: 1px solid var(--border);
        border-radius: 14px;

        background: rgba(255, 255, 255, 0.55);

        transition:
          transform 160ms ease,
          border-color 160ms ease,
          background 160ms ease;
      }

      .article-card:hover {
        transform: translateY(-3px);

        border-color: var(--wisteria);

        background: var(--surface);
      }

      .article-link {
        height: 100%;

        display: flex;
        flex-direction: column;

        text-decoration: none;
      }

      .category {
        color: var(--purple);

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      h2 {
        margin: 14px 0;

        color: var(--text);

        font-size: 30px;
        font-weight: 700;

        line-height: 1.15;
        letter-spacing: -0.03em;
      }

      .description {
        margin: 0;

        color: var(--text-muted);

        font-size: 16px;
        line-height: 1.6;
      }

      .meta {
        margin-top: auto;
        padding-top: 28px;

        display: flex;
        flex-wrap: wrap;

        gap: 7px 18px;

        color: var(--text-muted);

        font-size: 12px;
      }

      .read {
        color: var(--purple);

        font-weight: 700;
      }

      .empty {
        color: var(--text-muted);

        font-size: 18px;
      }

      @media (max-width: 760px) {
        .page-hero {
          padding: 62px 0 50px;
        }

        .articles-section {
          padding: 48px 0 70px;
        }

        .articles-grid {
          grid-template-columns: 1fr;
        }

        .article-card {
          min-height: 260px;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <section class="page-hero">
        <div class="site-container hero-inner">
          <div class="eyebrow">
            Field Notes
          </div>

          <h1 class="page-title">
            Articles
          </h1>

          <p class="page-description">
            Deep dives into reliability engineering,
            distributed systems, observability, platform
            engineering and AI-powered operations.
          </p>
        </div>
      </section>

      <section class="articles-section">
        <div class="site-container">
          {
            articles.length > 0 ? (
              <div class="articles-grid">
                {articles.map((article) => (
                  <article class="article-card">
                    <a
                      class="article-link"
                      href={`/articles/${article.id}`}
                    >
                      <div class="category">
                        {article.data.category}
                      </div>

                      <h2>
                        {article.data.title}
                      </h2>

                      <p class="description">
                        {article.data.description}
                      </p>

                      <div class="meta">
                        <span>
                          {formatDate(article.data.pubDate)}
                        </span>

                        <span>
                          {article.data.readTime}
                        </span>

                        <span class="read">
                          Read →
                        </span>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty">
                Articles are coming soon.
              </p>
            )
          }
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>