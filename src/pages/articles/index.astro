---
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TopicFilter from '../../components/TopicFilter.astro';

const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.pubDate.valueOf() -
    a.data.pubDate.valueOf()
);
---

<!doctype html>

<html lang="en">
  <head>
    <BaseHead
      title="Articles | The Reliability Loop"
      description="Field notes and deep dives on SRE, platform engineering, distributed systems, observability, AI and automation."
    />

    <style>
      .page-hero {
        position: relative;

        overflow: hidden;

        padding: 82px 0 66px;

        border-bottom: 1px solid var(--border);
      }

      .page-hero::before {
        content: "";

        position: absolute;

        width: 380px;
        height: 380px;

        top: -230px;
        right: -80px;

        border-radius: 50%;

        background: var(--lavender);

        opacity: 0.35;
      }

      .hero-inner {
        position: relative;
        z-index: 1;
      }

      .page-title {
        margin-top: 20px;
      }

      .articles-section {
        padding: 65px 0 95px;
      }

      .articles-grid {
        display: grid;

        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        gap: 26px;
      }

      .empty {
        color: var(--text-muted);

        font-size: 18px;
      }

      @media (max-width: 760px) {
        .page-hero {
          padding: 62px 0 50px;
        }

        .articles-section {
          padding: 48px 0 70px;
        }

        .articles-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <section class="page-hero">
        <div class="site-container hero-inner">
          <div class="eyebrow">
            Field Notes
          </div>

          <h1 class="page-title">
            Articles
          </h1>

          <p class="page-description">
            Deep dives into reliability engineering,
            distributed systems, observability, platform
            engineering and AI-powered operations.
          </p>

          <TopicFilter articles={articles} />
        </div>
      </section>

      <section class="articles-section">
        <div class="site-container">
          {
            articles.length > 0 ? (
              <div class="articles-grid">
                {articles.map((article) => (
                  <ArticleCard article={article} />
                ))}
              </div>
            ) : (
              <p class="empty">
                Articles are coming soon.
              </p>
            )
          }
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
