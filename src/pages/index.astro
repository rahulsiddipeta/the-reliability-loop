---
import { getCollection } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const topics = [
  'SRE',
  'Platform Engineering',
  'Distributed Systems',
  'Observability',
  'AI & Automation',
];

const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.pubDate.valueOf() -
    a.data.pubDate.valueOf()
);

const featured =
  articles.find((article) => article.data.featured) ??
  articles[0];

const latest = articles
  .filter((article) => article.id !== featured?.id)
  .slice(0, 4);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
  });
---

<!doctype html>

<html lang="en">
  <head>
    <BaseHead
      title="The Reliability Loop"
      description="Ideas and deep dives on reliability engineering, distributed systems, observability, platform engineering and AI in production operations."
    />

    <style>
      .hero {
        position: relative;

        overflow: hidden;

        padding: 105px 0 88px;
      }

      .hero::before {
        content: "";

        position: absolute;

        width: 500px;
        height: 500px;

        right: -180px;
        top: -260px;

        border-radius: 50%;

        background: var(--lavender);

        opacity: 0.35;

        pointer-events: none;
      }

      .hero::after {
        content: "";

        position: absolute;

        width: 230px;
        height: 230px;

        right: 190px;
        top: -130px;

        border-radius: 50%;

        background: var(--wisteria);

        opacity: 0.22;

        pointer-events: none;
      }

      .hero-inner {
        position: relative;
        z-index: 1;
      }

      .hero h1 {
        max-width: 930px;

        margin: 23px 0 0;

        color: var(--text);

        font-size: clamp(54px, 7vw, 90px);
        font-weight: 700;

        line-height: 0.98;
        letter-spacing: -0.055em;
      }

      .hero-copy {
        max-width: 720px;

        margin: 31px 0 0;

        color: var(--text-muted);

        font-size: 20px;
        line-height: 1.6;
      }

      .topics {
        display: flex;
        flex-wrap: wrap;

        gap: 9px;

        margin-top: 35px;
      }

      .topic {
        padding: 8px 13px;

        border: 1px solid var(--wisteria);
        border-radius: 999px;

        background: var(--wisteria-soft);

        color: #5c435f;

        font-size: 12px;

        text-decoration: none;

        transition:
          border-color 150ms ease,
          background 150ms ease,
          color 150ms ease;
      }

      .topic:hover {
        border-color: var(--purple);

        background: var(--lavender-soft);

        color: var(--purple-dark);
      }

      .home-section {
        padding: 66px 0;

        border-top: 1px solid var(--border);
      }

      .section-label {
        margin-bottom: 28px;

        color: var(--text-muted);

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .featured {
        display: grid;

        grid-template-columns:
          minmax(0, 1.5fr)
          minmax(220px, 0.5fr);

        gap: 75px;
      }

      .category {
        color: var(--purple);

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .featured h2 {
        max-width: 760px;

        margin: 15px 0 0;

        color: var(--text);

        font-size: clamp(38px, 5vw, 60px);
        font-weight: 700;

        line-height: 1.06;
        letter-spacing: -0.04em;
      }

      .featured-title-link {
        text-decoration: none;
      }

      .featured-title-link:hover h2 {
        color: var(--purple-dark);
      }

      .featured-description {
        max-width: 680px;

        margin: 23px 0 0;

        color: var(--text-muted);

        font-size: 18px;
        line-height: 1.6;
      }

      .featured-side {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;

        gap: 9px;

        color: var(--text-muted);

        font-size: 13px;
      }

      .read-link {
        display: inline-block;

        margin-top: 8px;

        color: var(--purple);

        text-decoration: none;

        font-weight: 700;
      }

      .read-link:hover {
        color: var(--purple-dark);
      }

      .empty-message {
        color: var(--text-muted);

        font-size: 16px;
        line-height: 1.6;
      }

      .articles-grid {
        display: grid;

        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        gap: 28px;
      }

      .article-card {
        min-height: 250px;

        padding: 27px;

        border: 1px solid var(--border);
        border-radius: 14px;

        background: rgba(255, 255, 255, 0.52);

        transition:
          transform 160ms ease,
          border-color 160ms ease,
          background 160ms ease;
      }

      .article-card:hover {
        transform: translateY(-3px);

        border-color: var(--wisteria);

        background: var(--surface);
      }

      .article-card-link {
        height: 100%;

        display: flex;
        flex-direction: column;

        text-decoration: none;
      }

      .article-card h3 {
        margin: 13px 0;

        color: var(--text);

        font-size: 27px;
        font-weight: 700;

        line-height: 1.18;
        letter-spacing: -0.025em;
      }

      .article-card p {
        margin: 0 0 18px;

        color: var(--text-muted);

        font-size: 15px;
        line-height: 1.6;
      }

      .article-meta {
        margin-top: auto;

        color: var(--purple);

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .loop-section {
        text-align: center;
      }

      .loop-section h2 {
        margin: 0;

        color: var(--text);

        font-size: clamp(38px, 5vw, 56px);
        font-weight: 700;

        letter-spacing: -0.04em;
      }

      .loop-intro {
        max-width: 650px;

        margin: 18px auto 0;

        color: var(--text-muted);

        font-size: 17px;
        line-height: 1.6;
      }

      .loop {
        max-width: 660px;

        margin: 31px auto 0;

        padding: 34px;

        border: 1px solid var(--wisteria);
        border-radius: 14px;

        background:
          linear-gradient(
            120deg,
            var(--lavender-soft),
            var(--wisteria-soft)
          );

        color: var(--text-body);

        font-family:
          "SFMono-Regular",
          Consolas,
          "Liberation Mono",
          monospace;

        font-size: 14px;
        line-height: 2;
      }

      .loop strong {
        color: var(--purple);

        font-weight: 700;
      }

      @media (max-width: 760px) {
        .hero {
          padding: 70px 0 62px;
        }

        .hero h1 {
          font-size: clamp(50px, 14vw, 67px);
        }

        .hero-copy {
          font-size: 18px;
        }

        .hero::before {
          opacity: 0.2;
        }

        .hero::after {
          display: none;
        }

        .home-section {
          padding: 52px 0;
        }

        .featured {
          grid-template-columns: 1fr;

          gap: 30px;
        }

        .featured-side {
          align-items: flex-start;
        }

        .articles-grid {
          grid-template-columns: 1fr;
        }

        .loop {
          padding: 27px 18px;

          font-size: 12px;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="site-container hero-inner">
          <div class="eyebrow">
            Reliability Engineering / Field Notes
          </div>

          <h1>
            Engineering systems that survive reality.
          </h1>

          <p class="hero-copy">
            Ideas and deep dives on reliability engineering,
            distributed systems, observability, platform engineering
            and the emerging role of AI in production operations.
          </p>

          <div class="topics">
            {
              topics.map((topic) => (
                <a
                  class="topic"
                  href={`/topics#${topic
                    .toLowerCase()
                    .replaceAll(' ', '-')
                    .replaceAll('&', 'and')}`}
                >
                  {topic}
                </a>
              ))
            }
          </div>
        </div>
      </section>

      {
        featured && (
          <section class="home-section">
            <div class="site-container">
              <div class="section-label">
                Featured / 001
              </div>

              <div class="featured">
                <div>
                  <div class="category">
                    {featured.data.category}
                  </div>

                  <a
                    class="featured-title-link"
                    href={`/articles/${featured.id}`}
                  >
                    <h2>
                      {featured.data.title}
                    </h2>
                  </a>

                  <p class="featured-description">
                    {featured.data.description}
                  </p>
                </div>

                <div class="featured-side">
                  <span>
                    {featured.data.author}
                  </span>

                  <span>
                    {featured.data.readTime}
                  </span>

                  <span>
                    {formatDate(featured.data.pubDate)}
                  </span>

                  <a
                    class="read-link"
                    href={`/articles/${featured.id}`}
                  >
                    Read article →
                  </a>
                </div>
              </div>
            </div>
          </section>
        )
      }

      <section class="home-section">
        <div class="site-container">
          <div class="section-label">
            Latest from the loop
          </div>

          {
            latest.length > 0 ? (
              <div class="articles-grid">
                {latest.map((article) => (
                  <article class="article-card">
                    <a
                      class="article-card-link"
                      href={`/articles/${article.id}`}
                    >
                      <div class="category">
                        {article.data.category}
                      </div>

                      <h3>
                        {article.data.title}
                      </h3>

                      <p>
                        {article.data.description}
                      </p>

                      <div class="article-meta">
                        {article.data.readTime} →
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty-message">
                More field notes are coming soon.
              </p>
            )
          }
        </div>
      </section>

      <section class="home-section loop-section">
        <div class="site-container">
          <div class="section-label">
            The operating model
          </div>

          <h2>
            Reliability is a loop.
          </h2>

          <p class="loop-intro">
            Reliable systems continuously observe, understand,
            act and learn from production reality.
          </p>

          <div class="loop">
            <strong>OBSERVE</strong>
            <br />
            ↓
            <br />
            DETECT → UNDERSTAND → DECIDE
            <br />
            ↓
            <br />
            ACT → VERIFY → LEARN
            <br />
            ↓
            <br />
            <strong>↻ REPEAT</strong>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>