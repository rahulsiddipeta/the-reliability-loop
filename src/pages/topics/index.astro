---
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { topics } from '../../topics';

const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.pubDate.valueOf() -
    a.data.pubDate.valueOf()
);

const topicsWithArticles = topics.map((topic) => ({
  ...topic,
  articles: articles.filter(
    (article) => article.data.category === topic.name
  ),
}));
---

<!doctype html>

<html lang="en">
  <head>
    <BaseHead
      title="Topics | The Reliability Loop"
      description="Explore reliability engineering, platform engineering, distributed systems, observability, AI and automation."
    />

    <style>
      .page-hero {
        position: relative;

        overflow: hidden;

        padding: 82px 0 66px;

        border-bottom: 1px solid var(--border);
      }

      .page-hero::before {
        content: "";

        position: absolute;

        width: 380px;
        height: 380px;

        top: -230px;
        right: -80px;

        border-radius: 50%;

        background: var(--wisteria);

        opacity: 0.28;
      }

      .hero-inner {
        position: relative;
        z-index: 1;
      }

      .page-title {
        margin-top: 20px;
      }

      .topics-section {
        padding: 60px 0 95px;
      }

      .topic {
        scroll-margin-top: 30px;

        display: grid;

        grid-template-columns: 70px 260px 1fr;

        gap: 35px;

        padding: 38px 0;

        border-bottom: 1px solid var(--border);
      }

      .topic:first-child {
        border-top: 1px solid var(--border);
      }

      .number {
        color: var(--purple);

        font-size: 12px;
        font-weight: 700;

        letter-spacing: 0.12em;
      }

      .topic h2 {
        margin: 0;

        color: var(--text);

        font-size: 29px;
        font-weight: 700;

        line-height: 1.15;
        letter-spacing: -0.03em;
      }

      .topic p {
        max-width: 620px;

        margin: 0;

        color: var(--text-muted);

        font-size: 16px;
        line-height: 1.65;
      }

      .topic h2 a {
        color: inherit;

        text-decoration: none;
      }

      .topic h2 a:hover {
        color: var(--purple-dark);
      }

      .topic-articles {
        margin: 18px 0 0;
        padding: 0;

        list-style: none;
      }

      .topic-articles li {
        padding: 7px 0;

        border-top: 1px solid var(--border);
      }

      .topic-articles a {
        color: var(--text);

        font-size: 15px;
        font-weight: 600;

        text-decoration: none;
      }

      .topic-articles a:hover {
        color: var(--purple-dark);
      }

      .topic-link {
        display: inline-block;

        margin-top: 16px;

        color: var(--purple);

        font-size: 14px;
        font-weight: 700;

        text-decoration: none;
      }

      .topic-link:hover {
        color: var(--purple-dark);
      }

      @media (max-width: 760px) {
        .page-hero {
          padding: 62px 0 50px;
        }

        .topics-section {
          padding: 48px 0 70px;
        }

        .topic {
          grid-template-columns: 45px 1fr;

          gap: 14px 20px;

          padding: 30px 0;
        }

        .topic-body {
          grid-column: 2;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <section class="page-hero">
        <div class="site-container hero-inner">
          <div class="eyebrow">
            Explore the Loop
          </div>

          <h1 class="page-title">
            Topics
          </h1>

          <p class="page-description">
            The engineering disciplines behind systems that
            remain understandable, recoverable and reliable
            under real production conditions.
          </p>
        </div>
      </section>

      <section class="topics-section">
        <div class="site-container">
          {
            topicsWithArticles.map((topic) => (
              <article
                class="topic"
                id={topic.id}
              >
                <div class="number">
                  {topic.number}
                </div>

                <h2>
                  <a href={`/topics/${topic.id}`}>
                    {topic.name}
                  </a>
                </h2>

                <div class="topic-body">
                  <p>
                    {topic.description}
                  </p>

                  {topic.articles.length > 0 && (
                    <ul class="topic-articles">
                      {topic.articles.slice(0, 3).map((article) => (
                        <li>
                          <a href={`/articles/${article.id}`}>
                            {article.data.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}

                  <a class="topic-link" href={`/topics/${topic.id}`}>
                    {topic.articles.length > 0
                      ? `View all ${topic.articles.length} ${topic.articles.length === 1 ? 'article' : 'articles'} →`
                      : 'Articles coming soon →'}
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>